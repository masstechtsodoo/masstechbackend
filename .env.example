NODE_ENV=development
PORT=4000

# Neon → Dashboard → Connection string (choose "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/masstech?sslmode=require
DB_POOL_MAX=10

# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin – created automatically on boot if no admin exists yet
ADMIN_EMAIL=admin@masstech.mn
ADMIN_PASSWORD=

CORS_ORIGINS=https://masstech.mn,https://www.masstech.mn,http://localhost:3000

# Cloudinary → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=masstech

# Optional: e-mail notification for new contact messages (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@masstech.mn
CONTACT_FROM_EMAIL=Mass Tech Website <web@masstech.mn>
